<%- layout('layout/boilerplate') %>

<style>
    body {
        background-color: #0f172a; 
        color: #f8fafc;
        font-family: 'Plus Jakarta Sans', sans-serif;
        margin: 0;
        padding: 0;
    }

    .custom-navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 20px;
        background-color: #0f172a; 
        border-bottom: 1px solid #334155;
        position: sticky; 
        top: 0;
        z-index: 1000;
    }

    .nav-left { display: flex; align-items: center; gap: 12px; }
    
    /* 🔥 COMPACT BACK ARROW BUTTON 🔥 */
    .btn-back-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #475569;
        background: transparent;
        color: #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s;
        cursor: pointer;
    }
    .btn-back-icon:hover { background-color: rgba(255, 255, 255, 0.05); color: white; border-color: #cbd5e1; }

    .brand-logo { font-weight: 800; font-size: 1.4rem; background: linear-gradient(90deg, #818cf8, #c084fc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; margin: 0; }
    .nav-controls { display: flex; gap: 16px; align-items: center; position: relative; }
    
    .btn-nav-primary { background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white; border: none; border-radius: 8px; padding: 8px 16px; font-weight: 700; font-size: 0.85rem; text-decoration: none; box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3); }
    .btn-nav-secondary { border: 1px solid #475569; color: #cbd5e1; border-radius: 8px; padding: 8px 16px; font-weight: 600; font-size: 0.85rem; text-decoration: none; background: transparent; cursor: pointer; }

    .hamburger-btn { background: transparent; border: none; color: #cbd5e1; font-size: 1.5rem; padding: 0; cursor: pointer; display: none; }
    .btn-profile-circle { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(90deg, #6366f1, #8b5cf6); display: flex; align-items: center; justify-content: center; color: white; border: none; font-size: 1.2rem; cursor: pointer; position: relative; }
    .status-dot { position: absolute; bottom: 0; right: 0; width: 12px; height: 12px; background-color: #22c55e; border: 2px solid #0f172a; border-radius: 50%; display: block; }

    .mobile-dropdown { display: none; position: absolute; top: 140%; right: 50px; background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 12px; flex-direction: column; gap: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.6); min-width: 160px; }
    .mobile-dropdown.show { display: flex; }
    .dropdown-link { border: 1px solid #475569; color: #cbd5e1; border-radius: 8px; padding: 10px; font-weight: 600; font-size: 0.9rem; text-decoration: none; text-align: center; }
    .dropdown-link.primary { background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white; border: none; }

    .tracker-container { max-width: 1100px; margin: 0 auto; padding: 30px 15px; }
    .tracker-header h2 { font-weight: 800; font-size: 1.75rem; }
    .text-gradient { background: linear-gradient(90deg, #818cf8, #c084fc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

    .dash-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); margin-bottom: 24px; }

    .calendar-wrapper { display: flex; justify-content: center; width: 100%; padding-bottom: 10px; }
    .calendar-grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 8px; width: 100%; max-width: 550px; }
    .day-box { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 6px; font-size: 0.85rem; font-weight: 700; position: relative; }
    
    .day-completed { background-color: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .day-active { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; box-shadow: 0 0 15px rgba(99, 102, 241, 0.5); border: none; }
    .day-locked { background-color: #0f172a; color: #475569; border: 1px solid #1e293b; }

    .achievements-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
    .achievement-pill { display: flex; align-items: center; background-color: #0f172a; border: 1px solid #334155; border-radius: 10px; padding: 12px 16px; font-size: 0.9rem; font-weight: 600; color: #cbd5e1; }
    .achievement-pill.unlocked { background-color: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.3); color: #10b981; }

    /* 🔥 MOBILE COMPACT UI FIXES 🔥 */
    @media (max-width: 576px) {
        .auth-desktop { display: none !important; }
        .hamburger-btn { display: block; }
        
        .tracker-container { padding: 12px 10px !important; }
        .tracker-header h2 { font-size: 1.35rem !important; }
        .tracker-header p { font-size: 0.75rem !important; }
        
        .dash-card { padding: 16px 12px !important; margin-bottom: 16px !important; border-radius: 12px !important; }
        .dash-card h2 { font-size: 1.5rem !important; }
        .dash-card h5 { font-size: 1rem !important; margin-bottom: 12px !important; }
        .dash-card h6 { font-size: 0.75rem !important; }
        
        .calendar-grid { gap: 6px !important; }
        .day-box { font-size: 0.7rem !important; border-radius: 4px !important; }
        
        .achievements-grid { gap: 10px !important; grid-template-columns: 1fr 1fr !important; }
        .achievement-pill { padding: 8px 10px !important; font-size: 0.75rem !important; border-radius: 8px !important; }
        
        .timeline h5 { font-size: 1.05rem !important; }
        .timeline h6 { font-size: 0.85rem !important; }
        .timeline p { font-size: 0.75rem !important; }
        
        .badge { font-size: 0.65rem !important; padding: 4px 6px !important; }
    }
</style>

<nav class="custom-navbar">
    <div class="nav-left">
        <!-- 🔥 SMART BACK BUTTON (Goes back to previous page dynamically) 🔥 -->
        <a onclick="goBack()" class="btn-back-icon" title="Go Back">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h2 class="brand-logo">ABTalks</h2>
    </div>

    <div id="navWrapper" class="nav-controls is-logged-in">
        <div class="auth-desktop" style="display: flex; gap: 12px;">
            <a href="/dashboard?userId=<%= user.id %>" class="btn-nav-secondary">Dashboard 🚀</a>
        </div>
        <button id="hamburgerBtn" class="hamburger-btn" onclick="toggleMenu(event)"><i class="fa-solid fa-bars"></i></button>
        <div id="navDropdown" class="mobile-dropdown">
            <a href="/dashboard?userId=<%= user.id %>" class="dropdown-link primary">Dashboard 🚀</a>
        </div>
        <button id="profileCircleBtn" class="btn-profile-circle" onclick="openProfileModal(event)"><i class="fa-solid fa-user"></i><div id="activeDot" class="status-dot"></div></button>
    </div>
</nav>

<div class="tracker-container">
    <div class="tracker-header mb-4">
        <h2 class="m-0">Your Progress <span class="text-gradient">Tracker</span> 📊</h2>
        <p class="text-secondary mt-1 small m-0">Track your 60-day intensive journey, unlock achievements, and view past builds.</p>
    </div>

    <!-- RANK BOX -->
    <% 
        let rank = Math.max(1, 150 - (user.streak * 5) - user.id);
        let placesUp = user.streak > 0 ? Math.floor(user.streak / 2) + 1 : 0;
    %>
    <div class="dash-card">
        <h6 class="fw-bold text-light mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Your Standing</h6>
        <h2 class="fw-bold text-light m-0 mb-1">#<%= rank %> <span class="text-secondary fw-normal" style="font-size: 0.8rem;">out of 1,240</span></h2>
        <% if (placesUp > 0) { %>
            <p class="text-success small fw-bold m-0" style="font-size: 0.75rem;"><i class="fa-solid fa-arrow-trend-up me-1"></i> Up <%= placesUp %> places this week</p>
        <% } else { %>
            <p class="text-secondary small fw-bold m-0" style="font-size: 0.75rem;"><i class="fa-solid fa-minus me-1"></i> Steady this week</p>
        <% } %>
    </div>

    <!-- CALENDAR -->
    <div class="dash-card">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h5 class="fw-bold text-light m-0">60-Day Progress</h5>
            <span class="badge bg-dark border border-secondary text-light" style="font-size: 0.7rem;">Day <%= user.progress %> Active</span>
        </div>
        <div class="calendar-wrapper">
            <div class="calendar-grid">
                <% for(let i = 1; i <= 60; i++) { %>
                    <% if (i < user.progress) { %>
                        <div class="day-box day-completed"><%= i < 10 ? '0'+i : i %></div>
                    <% } else if (i == user.progress) { %>
                        <div class="day-box day-active"><%= i < 10 ? '0'+i : i %></div>
                    <% } else { %>
                        <div class="day-box day-locked"><i class="fa-solid fa-lock" style="font-size: 0.4rem; position: absolute; top: 3px; right: 3px; opacity: 0.5;"></i><%= i < 10 ? '0'+i : i %></div>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ACHIEVEMENTS -->
    <div class="dash-card">
        <h5 class="fw-bold text-light mb-3">Achievements 🏆</h5>
        <div class="achievements-grid">
            <div class="achievement-pill unlocked"><i class="fa-solid fa-rocket me-2"></i> First Build</div>
            <div class="achievement-pill <%= user.streak >= 7 ? 'unlocked' : '' %>"><i class="fa-solid fa-fire me-2"></i> 7-Day Streak</div>
            <div class="achievement-pill <%= user.streak >= 10 ? 'unlocked' : '' %>"><i class="fa-solid fa-code-merge me-2"></i> 10 Builds</div>
            <div class="achievement-pill <%= user.streak >= 30 ? 'unlocked' : '' %>"><i class="fa-solid fa-lock me-2"></i> 30-Day Streak</div>
        </div>
    </div>

    <!-- JOURNEY TIMELINE -->
    <div class="dash-card">
        <h5 class="fw-bold text-light mb-4">Your Build Journey 🗺️</h5>
        <div class="timeline" style="border-left: 2px dashed #334155; padding-left: 15px; margin-left: 5px;">
            <div class="position-relative mb-4">
                <div class="position-absolute" style="left: -25px; top: 0; background: #1e293b; padding: 2px;">
                    <div style="width: 14px; height: 14px; background: #8b5cf6; border-radius: 50%; box-shadow: 0 0 8px #8b5cf6;"></div>
                </div>
                <!-- 🔥 ID added to badge for dynamic update 🔥 -->
                <span id="trackerDayBadge" class="badge bg-primary bg-opacity-25 text-primary mb-1" style="font-size: 0.65rem;">DAY <%= user.progress %> (ACTIVE)</span>
                <h5 class="fw-bold text-light m-0"><%= user.currentTaskTitle %></h5>
                <p class="text-secondary small mt-1 m-0" style="line-height: 1.4;"><%= user.currentTaskDesc %></p>

                <!-- 🔥 Under Review Notice Box 🔥 -->
                <div id="trackerReviewNotice" style="display: none;" class="mt-3 p-3 rounded" style="background-color: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3);">
                    <p class="text-info small m-0 fw-bold" style="font-size: 0.85rem;"><i class="fa-solid fa-clock me-1"></i> Links Received — Under Review ⏳</p>
                    <p class="text-secondary small m-0 mt-1" style="font-size: 0.75rem; line-height: 1.4;">We have your proof of work. We will review and update your status shortly.</p>
                </div>
            </div>

            <% if(user.pastTasks && user.pastTasks.length > 0) { %>
                <% user.pastTasks.forEach((task) => { %>
                    <div class="position-relative mb-3">
                        <div class="position-absolute" style="left: -24px; top: 2px; background: #1e293b; padding: 1px;"><i class="fa-solid fa-circle-check text-success" style="font-size: 1rem; background: #1e293b;"></i></div>
                        <h6 class="text-light fw-bold m-0 mb-1">DAY <%= task.day %>: <%= task.title %></h6>
                        <p class="text-secondary small m-0"><i class="fa-regular fa-clock me-1"></i> Submitted at <%= task.time %></p>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-secondary small m-0">No past tasks found yet.</p>
            <% } %>
            
            <div class="position-relative mt-4 opacity-50">
                <div class="position-absolute" style="left: -24px; top: 2px; background: #1e293b; padding: 1px;"><i class="fa-solid fa-circle-check text-success" style="font-size: 1rem; background: #1e293b;"></i></div>
                <h6 class="text-light fw-bold m-0 mb-1">DAY 1: Challenge Accepted</h6>
                <p class="text-secondary small m-0">The journey began.</p>
            </div>
        </div>
    </div>

    <!-- RECENT PROOFS -->
    <div class="dash-card">
        <h6 class="fw-bold text-light mb-3">Recent Proofs <i class="fa-solid fa-link text-info ms-1"></i></h6>
        <% if(user.progress > 1) { %>
            <div class="d-flex justify-content-between align-items-center p-2 rounded mb-2" style="background: #0f172a; border: 1px solid #334155;">
                <span class="text-secondary small fw-bold" style="font-size: 0.75rem;">Day <%= user.progress - 1 %> Build</span>
                <div><span class="badge bg-secondary bg-opacity-25 text-light me-1 px-1"><i class="fa-brands fa-github"></i></span><span class="badge bg-secondary bg-opacity-25 text-light px-1"><i class="fa-brands fa-linkedin"></i></span></div>
            </div>
        <% } %>
        <% if(user.progress > 2) { %>
            <div class="d-flex justify-content-between align-items-center p-2 rounded" style="background: #0f172a; border: 1px solid #334155;">
                <span class="text-secondary small fw-bold" style="font-size: 0.75rem;">Day <%= user.progress - 2 %> Build</span>
                <div><span class="badge bg-secondary bg-opacity-25 text-light me-1 px-1"><i class="fa-brands fa-github"></i></span><span class="badge bg-secondary bg-opacity-25 text-light px-1"><i class="fa-brands fa-linkedin"></i></span></div>
            </div>
        <% } %>
    </div>
</div>

<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered px-3">
      <div class="modal-content" style="background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 16px;">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-title fw-bold">Demo Profile</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start pt-2 pb-4">
          <h4 class="text-light fw-bold mb-0"><%= user.name %></h4>
          <p class="text-secondary small mb-3"><%= user.username || "@student_dev" %></p>
          <div class="p-3 rounded mb-3" style="background-color: #0f172a; border: 1px solid #334155;">
              <p class="mb-1 small"><strong class="text-info">Track:</strong> <%= user.track %></p>
          </div>
          <button class="btn btn-outline-danger w-100 rounded-3" onclick="handleLogout()">Logout</button>
        </div>
      </div>
    </div>
</div>

<script>
    // 🔥 Check localStorage uniquely for this user on page load 🔥
    document.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('day12_submitted_<%= user.id %>') === 'true') {
            const badge = document.getElementById('trackerDayBadge');
            const notice = document.getElementById('trackerReviewNotice');
            if (badge) {
                badge.className = "badge bg-info bg-opacity-25 text-info mb-1";
                badge.innerHTML = "DAY <%= user.progress %> (UNDER REVIEW ⏳)";
            }
            if (notice) {
                notice.style.display = "block";
            }
        }
    });

    // 🔥 Smart Back Button Function 🔥
    function goBack() {
        if (document.referrer && document.referrer.includes('/dashboard')) {
            window.location.href = "/dashboard?userId=<%= user.id %>";
        } else if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = "/";
        }
    }

    function toggleMenu(event) { if(event) event.stopPropagation(); document.getElementById('navDropdown').classList.toggle('show'); }
    document.addEventListener('click', function(event) { var dropdown = document.getElementById('navDropdown'); if (dropdown && dropdown.classList.contains('show') && !dropdown.contains(event.target) && !document.getElementById('hamburgerBtn').contains(event.target)) { dropdown.classList.remove('show'); } });
    function openProfileModal(event) { if(event) event.stopPropagation(); document.getElementById('navDropdown').classList.remove('show'); new bootstrap.Modal(document.getElementById('profileModal')).show(); }
    function handleLogout() { localStorage.removeItem('abtalks_logged_in'); localStorage.removeItem('abtalks_user'); localStorage.removeItem('day12_submitted_<%= user.id %>'); window.location.href = '/'; }
</script>