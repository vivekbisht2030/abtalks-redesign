<%- layout('layout/boilerplate') %>

<style>
    body {
        background-color: #0f172a; 
        color: #f8fafc;
        font-family: 'Plus Jakarta Sans', sans-serif;
        margin: 0;
        padding: 0;
    }

    .custom-navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 20px;
        background-color: #0f172a; 
        border-bottom: 1px solid #334155;
        position: sticky; 
        top: 0;
        z-index: 1000;
    }

    .nav-left { display: flex; align-items: center; gap: 12px; }
    
    /* 🔥 COMPACT BACK ARROW BUTTON FOR LANDING PAGE 🔥 */
    .btn-back-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #475569;
        background: transparent;
        color: #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .btn-back-icon:hover { background-color: rgba(255, 255, 255, 0.05); color: white; border-color: #cbd5e1; }

    .brand-logo { font-weight: 800; font-size: 1.4rem; background: linear-gradient(90deg, #818cf8, #c084fc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; margin: 0; }
    .nav-controls { display: flex; gap: 16px; align-items: center; position: relative; }
    
    .btn-nav-primary { background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white; border: none; border-radius: 8px; padding: 8px 16px; font-weight: 700; font-size: 0.85rem; text-decoration: none; box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3); }
    .btn-nav-secondary { border: 1px solid #475569; color: #cbd5e1; border-radius: 8px; padding: 8px 16px; font-weight: 600; font-size: 0.85rem; text-decoration: none; background: transparent; cursor: pointer; }

    .hamburger-btn { background: transparent; border: none; color: #cbd5e1; font-size: 1.5rem; padding: 0; cursor: pointer; display: none; }
    .btn-profile-circle { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(90deg, #6366f1, #8b5cf6); display: flex; align-items: center; justify-content: center; color: white; border: none; font-size: 1.2rem; cursor: pointer; position: relative; }
    .status-dot { position: absolute; bottom: 0; right: 0; width: 12px; height: 12px; background-color: #22c55e; border: 2px solid #0f172a; border-radius: 50%; display: block; }

    .mobile-dropdown { display: none; position: absolute; top: 140%; right: 50px; background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 12px; flex-direction: column; gap: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.6); min-width: 160px; }
    .mobile-dropdown.show { display: flex; }
    .dropdown-link { border: 1px solid #475569; color: #cbd5e1; border-radius: 8px; padding: 10px; font-weight: 600; font-size: 0.9rem; text-decoration: none; text-align: center; }
    .dropdown-link.primary { background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white; border: none; }

    .dashboard-container { max-width: 1100px; margin: 0 auto; padding: 30px 15px; }
    .dash-header h2 { font-weight: 800; font-size: 1.75rem; }
    .text-gradient { background: linear-gradient(90deg, #818cf8, #c084fc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

    .dash-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); margin-bottom: 24px; }
    .dash-card:hover { border-color: #475569; }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 15px; }
    .icon-fire { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .icon-chart { background: rgba(99, 102, 241, 0.1); color: #818cf8; }
    .icon-trophy { background: rgba(234, 179, 8, 0.1); color: #eab308; }

    .progress-track { background-color: #0f172a; height: 10px; border-radius: 5px; width: 100%; margin-top: 15px; overflow: hidden; }
    .progress-fill { background: linear-gradient(90deg, #6366f1, #8b5cf6); height: 100%; border-radius: 5px; }

    .task-card { border-left: 4px solid #8b5cf6; }
    .track-badge { display: inline-block; background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; margin-bottom: 12px; }

    .btn-glow { background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white; border: none; border-radius: 8px; padding: 12px 24px; font-weight: 700; font-size: 0.95rem; cursor: pointer; text-decoration: none; display: inline-block; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4); }
    .task-input { background-color: #1e293b; border: 1px solid #475569; color: #f8fafc; border-radius: 8px; padding: 10px 12px; width: 100%; margin-bottom: 12px; font-size: 0.85rem; }

    .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }

    @media (max-width: 576px) {
        .auth-desktop { display: none !important; }
        .hamburger-btn { display: block; }
        .dashboard-container { padding: 15px 12px; }
        .stats-grid { grid-template-columns: 1fr 1fr !important; gap: 12px !important; margin-bottom: 20px !important; }
        .stats-grid .dash-card { padding: 12px !important; margin-bottom: 0 !important; }
        .stats-grid .dash-card:nth-child(3) { grid-column: span 2; }
        .stat-icon { width: 32px !important; height: 32px !important; font-size: 1rem !important; margin-bottom: 8px !important; border-radius: 8px !important; }
        .stats-grid .dash-card h3 { font-size: 1.25rem !important; }
        .stats-grid .dash-card p { font-size: 0.7rem !important; line-height: 1.2 !important; }
        .progress-track { margin-top: 8px !important; height: 6px !important; }
        .content-grid { grid-template-columns: 1fr; gap: 15px; }
        .task-card { padding: 18px 15px !important; }
        .task-card h3 { font-size: 1.2rem !important; }
        .btn-glow { padding: 10px 15px !important; font-size: 0.85rem !important; }
    }
</style>

<!-- 🔥 UNIVERSAL NAVBAR WITH BACK ARROW TO LANDING PAGE 🔥 -->
<nav class="custom-navbar">
    <div class="nav-left">
        <a href="/" class="btn-back-icon" title="Back to Home">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h2 class="brand-logo">ABTalks</h2>
    </div>

    <div id="navWrapper" class="nav-controls is-logged-in">
        <div class="auth-desktop" style="display: flex; gap: 12px;">
            <a href="/day/12?userId=<%= user.id %>" class="btn-nav-secondary">Progress Tracker</a>
        </div>
        <button id="hamburgerBtn" class="hamburger-btn" onclick="toggleMenu(event)"><i class="fa-solid fa-bars"></i></button>
        <div id="navDropdown" class="mobile-dropdown">
            <a href="/day/12?userId=<%= user.id %>" class="dropdown-link">Progress Tracker</a>
        </div>
        <button id="profileCircleBtn" class="btn-profile-circle" onclick="openProfileModal(event)"><i class="fa-solid fa-user"></i><div id="activeDot" class="status-dot"></div></button>
    </div>
</nav>

<div class="dashboard-container">
    <div class="dash-header mb-4">
        <h2 class="m-0">Welcome back, <span class="text-gradient"><%= user.name %>!</span> 👋</h2>
        <p class="text-secondary mt-1 small m-0">You are building undeniable proof of work. Keep the momentum going.</p>
    </div>

    <% 
        let standingText = "Rising Star ⭐";
        let cohortText = "Top 20% Cohort";
        if (user.streak >= 15) { standingText = "Elite Coder 🔥"; cohortText = "Top 1% Cohort"; } 
        else if (user.streak >= 10) { standingText = "Consistency King 👑"; cohortText = "Top 5% Cohort"; } 
        else if (user.streak >= 5) { standingText = "Steady Builder 🛠️"; cohortText = "Top 10% Cohort"; }
    %>

    <div class="stats-grid">
        <div class="dash-card mb-0">
            <div class="stat-icon icon-fire"><i class="fa-solid fa-fire"></i></div>
            <h3 class="fw-bold fs-2 m-0 text-light"><%= user.streak %> Days</h3>
            <p class="text-secondary small m-0 mt-1">Current Active Streak</p>
            <p class="text-success small m-0 mt-2" style="font-size: 0.75rem;"><i class="fa-solid fa-arrow-trend-up me-1"></i> Personal best!</p>
        </div>

        <div class="dash-card mb-0">
            <div class="stat-icon icon-chart"><i class="fa-solid fa-chart-pie"></i></div>
            <h3 class="fw-bold fs-2 m-0 text-light"><%= ((user.progress / 60) * 100).toFixed(1) %>%</h3>
            <p class="text-secondary small m-0 mt-1">Overall Challenge Completion</p>
            <div class="progress-track">
                <div class="progress-fill" id="userProgressBar"></div>
            </div>
            <script>
                document.getElementById('userProgressBar').style.width = "<%= (user.progress / 60) * 100 %>%";
            </script>
            <p class="text-secondary small m-0 mt-2 text-end" style="font-size: 0.75rem;"><%= user.progress %> / 60 Days</p>
        </div>

        <div class="dash-card mb-0">
            <div class="stat-icon icon-trophy"><i class="fa-solid fa-trophy"></i></div>
            <h3 class="fw-bold fs-4 m-0 text-light mt-2"><%= cohortText %></h3>
            <p class="text-secondary small m-0 mt-1">Current Standing</p>
            <div class="mt-3">
                <span class="badge bg-dark border border-secondary text-light me-1 p-2"><%= standingText %></span>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <div class="dash-card task-card">
            <span class="track-badge"><%= user.track %></span>
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h3 class="fw-bold text-light m-0 fs-4"><%= user.currentTaskTitle %></h3>
                <span id="taskStatusBadge" class="badge bg-secondary text-light">Pending ⏳</span>
            </div>

            <p class="text-secondary mb-4" style="font-size: 0.95rem; line-height: 1.6;"><%= user.currentTaskDesc %></p>

            <div id="submissionFormArea">
                <div class="p-3 rounded mb-4" style="background-color: #0f172a; border: 1px dashed #334155;">
                    <h6 class="text-info fw-bold mb-3 small"><i class="fa-solid fa-clipboard-check me-2"></i>Submission Requirements:</h6>
                    <input type="url" id="githubInput" class="task-input" placeholder="Paste GitHub Repository Link here..." required>
                    <input type="url" id="linkedinInput" class="task-input" placeholder="Paste LinkedIn Post Link here..." style="margin-bottom: 0;" required>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-secondary rounded-3 px-3 py-2" onclick="fillDemoLinks()" style="border-color: #475569; color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">Fill Demo Links 🪄</button>
                    <button class="btn-glow flex-grow-1 text-center" onclick="submitTaskProof()">Submit Proof <i class="fa-solid fa-upload ms-2"></i></button>
                </div>
            </div>

            <div id="successArea" style="display: none;" class="mt-2">
                <div class="p-3 rounded mb-4 text-center" style="background-color: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3);">
                    <i class="fa-solid fa-circle-check fs-2 text-success mb-2"></i>
                    <h6 class="fw-bold text-success m-0">Links Submitted Successfully!</h6>
                    <p class="text-secondary small m-0 mt-1">Your proof of work has been recorded.</p>
                </div>
                <a href="/day/12?userId=<%= user.id %>" class="btn-glow text-center w-100" style="background: linear-gradient(90deg, #10b981, #059669);">
                    View Progress Tracker <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>

        <div class="dash-card">
            <h5 class="fw-bold text-light mb-4">Your Journey 🗺️</h5>
            <div class="timeline">
                <% if(user.pastTasks && user.pastTasks.length > 0) { %>
                    <% user.pastTasks.forEach((task, index) => { %>
                        <div class="d-flex <%= index !== user.pastTasks.length - 1 ? 'mb-4' : '' %>">
                            <div class="me-3 text-success">
                                <i class="fa-solid fa-circle-check fs-5"></i>
                            </div>
                            <div>
                                <h6 class="text-light m-0 mb-1">Day <%= task.day %>: <%= task.title %></h6>
                                <p class="text-secondary small m-0">Submitted at <%= task.time %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-secondary small m-0">No past tasks found.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered px-3">
      <div class="modal-content" style="background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 16px;">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-title fw-bold">Demo Profile</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start pt-2 pb-4">
          <h4 class="text-light fw-bold mb-0"><%= user.name %></h4>
          <p class="text-secondary small mb-3"><%= user.username || "@student_dev" %></p>
          <div class="p-3 rounded mb-3" style="background-color: #0f172a; border: 1px solid #334155;">
              <p class="mb-1 small"><strong class="text-info">Track:</strong> <%= user.track %></p>
          </div>
          <button class="btn btn-outline-danger w-100 rounded-3" onclick="handleLogout()">Logout</button>
        </div>
      </div>
    </div>
</div>

<script>
    // 🔥 Check localStorage uniquely for this user on page load 🔥
    document.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('day12_submitted_<%= user.id %>') === 'true') {
            setSubmittedState();
        }
    });

    function setSubmittedState() {
        const badge = document.getElementById('taskStatusBadge');
        if (badge) {
            badge.className = "badge bg-success text-light";
            badge.innerHTML = "Completed ✅";
        }
        document.getElementById('submissionFormArea').style.display = "none";
        document.getElementById('successArea').style.display = "block";
    }

    function fillDemoLinks() {
        document.getElementById('githubInput').value = "https://github.com/demo-student/abtalks-task";
        document.getElementById('linkedinInput').value = "https://linkedin.com/in/demo-student/post/update";
    }

    function submitTaskProof() {
        const githubVal = document.getElementById('githubInput').value;
        const linkedinVal = document.getElementById('linkedinInput').value;

        if (!githubVal || !linkedinVal) {
            alert("Please provide both links or click 'Fill Demo Links' to test.");
            return;
        }

        // 🔥 Save state uniquely per user in localStorage 🔥
        localStorage.setItem('day12_submitted_<%= user.id %>', 'true');
        setSubmittedState();
    }

    function toggleMenu(event) { if(event) event.stopPropagation(); document.getElementById('navDropdown').classList.toggle('show'); }
    document.addEventListener('click', function(event) { var dropdown = document.getElementById('navDropdown'); if (dropdown && dropdown.classList.contains('show') && !dropdown.contains(event.target) && !document.getElementById('hamburgerBtn').contains(event.target)) { dropdown.classList.remove('show'); } });
    function openProfileModal(event) { if(event) event.stopPropagation(); document.getElementById('navDropdown').classList.remove('show'); new bootstrap.Modal(document.getElementById('profileModal')).show(); }
    function handleLogout() { localStorage.removeItem('abtalks_logged_in'); localStorage.removeItem('abtalks_user'); window.location.href = '/'; }
</script>