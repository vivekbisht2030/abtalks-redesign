<%- layout('layout/boilerplate') %>

<style>
    /* 🔥 Fixed Dark Background 🔥 */
    body {
        background-color: #0f172a; 
        color: #f8fafc;
        font-family: 'Plus Jakarta Sans', sans-serif;
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 15px;
    }

    .dash-header h2 {
        font-weight: 800;
        font-size: 1.75rem;
    }

    .text-gradient {
        background: linear-gradient(90deg, #818cf8, #c084fc);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .dash-card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
    }

    .dash-card:hover {
        border-color: #475569;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 15px;
    }

    .icon-fire {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    .icon-chart {
        background: rgba(99, 102, 241, 0.1);
        color: #818cf8;
    }

    .icon-trophy {
        background: rgba(234, 179, 8, 0.1);
        color: #eab308;
    }

    .progress-track {
        background-color: #0f172a;
        height: 10px;
        border-radius: 5px;
        width: 100%;
        margin-top: 15px;
        overflow: hidden;
    }

    .progress-fill {
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        height: 100%;
        border-radius: 5px;
    }

    .task-card {
        border-left: 4px solid #8b5cf6;
    }

    .track-badge {
        display: inline-block;
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .btn-glow {
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
        transition: all 0.3s;
    }

    .btn-glow:hover {
        background: linear-gradient(90deg, #4f46e5, #7c3aed);
        color: white;
    }

    .task-input {
        background-color: #1e293b;
        border: 1px solid #475569;
        color: #f8fafc;
        border-radius: 8px;
        padding: 10px 12px;
        width: 100%;
        margin-bottom: 12px;
        font-size: 0.85rem;
        transition: all 0.3s;
    }

    .task-input:focus {
        outline: none;
        border-color: #818cf8;
        box-shadow: 0 0 0 2px rgba(129, 140, 248, 0.2);
    }

    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    /* 🔥 STRICTLY FOR MOBILE VIEW (390px etc) 🔥 */
    @media (max-width: 576px) {
        .dashboard-container {
            padding: 15px 12px;
        }

        .header-wrap {
            flex-wrap: nowrap !important;
            align-items: flex-start !important; 
            gap: 8px !important;
        }
        .dash-header {
            flex-grow: 1; 
        }
        .dash-header h2 {
            font-size: 1.15rem !important; 
            line-height: 1.3 !important;
        }
        .dash-header p {
            font-size: 0.75rem !important;
            margin-top: 4px !important;
            line-height: 1.3;
        }
        .home-btn {
            padding: 5px 10px !important;
            font-size: 0.7rem !important;
            white-space: nowrap; 
            flex-shrink: 0; 
            margin-top: 2px; 
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr !important;
            gap: 12px !important;
            margin-bottom: 20px !important;
        }
        .stats-grid .dash-card {
            padding: 12px !important;
        }
        .stats-grid .dash-card:nth-child(3) {
            grid-column: span 2; 
        }

        .stat-icon {
            width: 32px !important;
            height: 32px !important;
            font-size: 1rem !important;
            margin-bottom: 8px !important;
            border-radius: 8px !important;
        }
        .stats-grid .dash-card h3 {
            font-size: 1.25rem !important;
        }
        .stats-grid .dash-card p {
            font-size: 0.7rem !important;
            line-height: 1.2 !important;
        }
        .stats-grid .dash-card .mt-3 {
            margin-top: 8px !important;
        }
        .progress-track {
            margin-top: 8px !important;
            height: 6px !important;
        }

        .content-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }
        .task-card {
            padding: 18px 15px !important;
        }
        .task-card h3 {
            font-size: 1.2rem !important;
        }
        .task-card p {
            font-size: 0.85rem !important;
        }
        .btn-glow {
            padding: 10px 15px !important;
            font-size: 0.85rem !important;
        }
        .task-input {
            padding: 8px 10px;
            font-size: 0.8rem;
        }
    }
</style>

<div class="dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4 header-wrap gap-3">
        <div class="dash-header m-0">
            <h2 class="m-0">Welcome back, <span class="text-gradient"><%= user.name %>!</span> 👋</h2>
            <p class="text-secondary mt-1 small m-0">You are building undeniable proof of work. Keep the momentum going.</p>
        </div>
        <a href="/" class="btn btn-outline-secondary rounded-3 text-light home-btn"
            style="border-color: #334155; background-color: #1e293b;">
            <i class="fa-solid fa-arrow-left me-1"></i> Home
        </a>
    </div>

    <!-- REQ 4: Dynamic Top % Cohort Logic in EJS -->
    <% 
        let standingText = "Rising Star ⭐";
        let cohortText = "Top 20% Cohort";
        
        if (user.streak >= 15) {
            standingText = "Elite Coder 🔥";
            cohortText = "Top 1% Cohort";
        } else if (user.streak >= 10) {
            standingText = "Consistency King 👑";
            cohortText = "Top 5% Cohort";
        } else if (user.streak >= 5) {
            standingText = "Steady Builder 🛠️";
            cohortText = "Top 10% Cohort";
        }
    %>

    <div class="stats-grid">
        <div class="dash-card">
            <div class="stat-icon icon-fire">
                <i class="fa-solid fa-fire"></i>
            </div>
            <h3 class="fw-bold fs-2 m-0 text-light"><%= user.streak %> Days</h3>
            <p class="text-secondary small m-0 mt-1">Current Active Streak</p>
            <p class="text-success small m-0 mt-2" style="font-size: 0.75rem;"><i class="fa-solid fa-arrow-trend-up me-1"></i> Personal best!</p>
        </div>

        <div class="dash-card">
            <div class="stat-icon icon-chart">
                <i class="fa-solid fa-chart-pie"></i>
            </div>
            <h3 class="fw-bold fs-2 m-0 text-light"><%= ((user.progress / 60) * 100).toFixed(1) %>%</h3>
            <p class="text-secondary small m-0 mt-1">Overall Challenge Completion</p>
            <div class="progress-track">
                <div class="progress-fill" id="dynamicBar"></div>
                <script>
                    document.getElementById('dynamicBar').style.width = "<%= (user.progress / 60) * 100 %>%";
                </script>
            </div>
            <p class="text-secondary small m-0 mt-2 text-end" style="font-size: 0.75rem;">
                <%= user.progress %> / 60 Days
            </p>
        </div>

        <div class="dash-card">
            <div class="stat-icon icon-trophy">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <h3 class="fw-bold fs-4 m-0 text-light mt-2"><%= cohortText %></h3>
            <p class="text-secondary small m-0 mt-1">Current Standing</p>
            <div class="mt-3">
                <span class="badge bg-dark border border-secondary text-light me-1 p-2"><%= standingText %></span>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <!-- REQ 4: Dynamic Task Rendering -->
        <div class="dash-card task-card">
            <span class="track-badge"><%= user.track %></span>
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h3 class="fw-bold text-light m-0 fs-4"><%= user.currentTaskTitle %></h3>
                <span id="taskStatusBadge" class="badge bg-secondary text-light">Pending ⏳</span>
            </div>

            <p class="text-secondary mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                <%= user.currentTaskDesc %>
            </p>

            <div id="submissionFormArea">
                <div class="p-3 rounded mb-4" style="background-color: #0f172a; border: 1px dashed #334155;">
                    <h6 class="text-info fw-bold mb-3 small"><i class="fa-solid fa-clipboard-check me-2"></i>Submission Requirements:</h6>
                    
                    <input type="url" id="githubInput" class="task-input" placeholder="Paste GitHub Repository Link here..." required>
                    <input type="url" id="linkedinInput" class="task-input" placeholder="Paste LinkedIn Post Link here..." style="margin-bottom: 0;" required>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-secondary rounded-3 px-3 py-2" onclick="fillDemoLinks()" style="border-color: #475569; color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">
                        Fill Demo Links 🪄
                    </button>
                    <button class="btn-glow flex-grow-1 text-center" onclick="submitTaskProof()">
                        Submit Proof <i class="fa-solid fa-upload ms-2"></i>
                    </button>
                </div>
            </div>

            <div id="successArea" style="display: none;" class="mt-2">
                <div class="p-3 rounded mb-4 text-center" style="background-color: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3);">
                    <i class="fa-solid fa-circle-check fs-2 text-success mb-2"></i>
                    <h6 class="fw-bold text-success m-0">Links Submitted Successfully!</h6>
                    <p class="text-secondary small m-0 mt-1">Your proof of work has been recorded.</p>
                </div>
                
                <a href="/day/12" class="btn-glow text-center w-100" style="background: linear-gradient(90deg, #10b981, #059669);">
                    View Progress Tracker <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>

        <div class="dash-card">
            <h5 class="fw-bold text-light mb-4">Your Journey 🗺️</h5>

            <div class="timeline">
                <!-- REQ 5: Dynamic Past Journey Loop -->
                <% if(user.pastTasks && user.pastTasks.length > 0) { %>
                    <% user.pastTasks.forEach((task, index) => { %>
                        <div class="d-flex <%= index !== user.pastTasks.length - 1 ? 'mb-4' : '' %>">
                            <div class="me-3 text-success">
                                <i class="fa-solid fa-circle-check fs-5"></i>
                            </div>
                            <div>
                                <h6 class="text-light m-0 mb-1">Day <%= task.day %>: <%= task.title %></h6>
                                <p class="text-secondary small m-0">Submitted at <%= task.time %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-secondary small m-0">No past tasks found.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    function fillDemoLinks() {
        document.getElementById('githubInput').value = "https://github.com/demo-student/abtalks-task";
        document.getElementById('linkedinInput').value = "https://linkedin.com/in/demo-student/post/update";
    }

    function submitTaskProof() {
        const githubVal = document.getElementById('githubInput').value;
        const linkedinVal = document.getElementById('linkedinInput').value;

        if (!githubVal || !linkedinVal) {
            alert("Please provide both links or click 'Fill Demo Links' to test.");
            return;
        }

        const badge = document.getElementById('taskStatusBadge');
        badge.className = "badge bg-success text-light";
        badge.innerHTML = "Completed ✅";

        document.getElementById('submissionFormArea').style.display = "none";
        document.getElementById('successArea').style.display = "block";
    }
</script>