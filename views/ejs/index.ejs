<%- layout('layout/boilerplate') %>

<style>
    /* Dark Theme Setup */
    body {
        background-color: #0f172a; 
        color: #f8fafc;
        font-family: 'Plus Jakarta Sans', sans-serif;
        margin: 0;
        padding: 0;
    }

    /* 📱 Universal Header */
    .custom-navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 20px;
        background-color: #0f172a; 
        border-bottom: 1px solid #334155;
        position: sticky; 
        top: 0;
        z-index: 1000;
    }

    .brand-logo {
        font-weight: 800;
        font-size: 1.4rem;
        background: linear-gradient(90deg, #818cf8, #c084fc);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }

    /* Right side controls wrapper */
    .nav-controls {
        display: flex;
        gap: 16px;
        align-items: center;
        position: relative;
    }

    /* Buttons */
    .btn-nav-primary {
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 700;
        font-size: 0.85rem; 
        text-decoration: none;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    }

    .btn-nav-secondary {
        border: 1px solid #475569;
        color: #cbd5e1;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        background: transparent;
        cursor: pointer;
    }

    /* 🔥 AUTHENTICATION VISIBILITY LOGIC 🔥 */
    .auth-desktop, .auth-mobile {
        display: none;
    }

    @media (min-width: 577px) {
        .is-logged-in .auth-desktop { 
            display: flex; 
            gap: 12px; 
            align-items: center; 
        }
    }

    @media (max-width: 576px) {
        .is-logged-in .auth-mobile { 
            display: block; 
        }
    }

    /* Hamburger Menu Button */
    .hamburger-btn {
        background: transparent;
        border: none;
        color: #cbd5e1;
        font-size: 1.5rem;
        padding: 0;
        cursor: pointer;
        transition: color 0.2s;
    }
    .hamburger-btn:hover { color: #818cf8; }

    /* Circular Profile Button */
    .btn-profile-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        border: none;
        font-size: 1.2rem;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
        cursor: pointer;
        position: relative;
    }
    
    .status-dot {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 12px;
        height: 12px;
        background-color: #22c55e;
        border: 2px solid #0f172a;
        border-radius: 50%;
        display: none; 
    }

    /* Mobile Dropdown Menu */
    .mobile-dropdown {
        display: none; 
        position: absolute;
        top: 140%; 
        right: 50px; 
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 12px;
        flex-direction: column;
        gap: 10px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        min-width: 160px;
    }
    .mobile-dropdown.show { display: flex; }
    
    .dropdown-link {
        border: 1px solid #475569;
        color: #cbd5e1;
        border-radius: 8px;
        padding: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s;
    }
    .dropdown-link.primary {
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
    }
    
    /* Layout */
    .mobile-container { max-width: 480px; margin: 0 auto; padding: 24px 15px; }
    .text-gradient { background: linear-gradient(90deg, #818cf8, #c084fc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; }
    .feature-card { background: rgba(30, 41, 59, 0.7); border: 1px solid #334155; border-radius: 16px; padding: 24px; margin-bottom: 20px; backdrop-filter: blur(10px); }
    .btn-glow { background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white; border: none; border-radius: 12px; padding: 12px 20px; font-weight: 700; font-size: 1rem; width: 100%; cursor: pointer; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4); }
    .footer-links a { color: #94a3b8; text-decoration: none; margin: 0 8px; font-size: 0.8rem; transition: color 0.2s; }
    .footer-links a:hover { color: #f8fafc; }

    /* 🔥 HERO ACTION BUTTONS CSS 🔥 */
    .action-buttons-container {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 30px; 
        margin-bottom: 20px;
    }

    .btn-primary-custom {
        background-color: #7b5cfa; 
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.3s ease;
        box-shadow: 0 4px 15px rgba(123, 92, 250, 0.4);
    }
    .btn-primary-custom:hover { background-color: #6344e6; }

    .btn-secondary-custom {
        background-color: transparent;
        color: #cbd5e1;
        border: 2px solid #475569;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .btn-secondary-custom:hover {
        color: white;
        border-color: #cbd5e1;
        background-color: rgba(255, 255, 255, 0.05);
    }

    /* 🔥 MOBILE SPECIFIC OPTIMIZATIONS (For 390px & Below) 🔥 */
    @media (max-width: 576px) {
        .mobile-hero {
            margin-top: 15px !important;
            /* Yahan margin badha diya taaki agla box screen se neeche chala jaye */
            margin-bottom: 100px !important; 
        }
        .mobile-hero h1 {
            font-size: 2.2rem !important;
            margin-bottom: 10px !important;
        }
        .mobile-hero p.lead-text {
            font-size: 0.9rem !important;
            margin-bottom: 15px !important;
        }
        .mobile-text-box {
            margin-top: 15px !important;
            margin-bottom: 15px !important;
        }
        .mobile-text-box h3 {
            font-size: 1.1rem !important;
            margin-bottom: 8px !important;
        }
        .mobile-text-box p {
            font-size: 0.85rem !important;
            line-height: 1.4 !important;
            padding: 0 !important;
        }
        .action-buttons-container {
            margin-top: 15px !important;
            gap: 10px;
        }
        .btn-primary-custom, .btn-secondary-custom {
            padding: 10px 10px;
            font-size: 0.85rem;
            flex: 1; 
            white-space: nowrap; 
        }
    }
</style>

<!-- 🔥 UNIVERSAL HEADER 🔥 -->
<nav class="custom-navbar">
    <h2 class="brand-logo">ABTalks</h2>
    
    <div id="navWrapper" class="nav-controls">
        <div class="auth-desktop">
            <a href="/day/12" class="btn-nav-secondary">Day 12 👀</a>
            <a href="/dashboard" class="btn-nav-primary">Dashboard 🚀</a>
        </div>

        <button class="hamburger-btn auth-mobile" onclick="toggleMenu()">
            <i class="fa-solid fa-bars"></i>
        </button>
        
        <div id="navDropdown" class="mobile-dropdown">
            <a href="/day/12" class="dropdown-link">Day 12 👀</a>
            <a href="/dashboard" class="dropdown-link primary">Dashboard 🚀</a>
        </div>

        <button id="profileCircleBtn" class="btn-profile-circle" onclick="handleProfileClick()">
            <i class="fa-solid fa-user"></i>
            <div id="activeDot" class="status-dot"></div>
        </button>
    </div>
</nav>

<div class="mobile-container">
    
    <!-- 🔥 FIXED SPACING HERO SECTION 🔥 -->
    <header class="text-center mt-4 mb-5 mobile-hero">
        <h1 class="display-5 fw-bold mb-3">Code. Commit.<br><span class="text-gradient">Get Hired.</span></h1>
        
        <p class="text-secondary mb-3 lead-text">Stop watching tutorials. Start building proof of work.</p>
        
        <div class="mx-auto mt-4 mb-4 mobile-text-box" style="max-width: 95%;">
            <h3 class="fw-bold mb-3 fs-5">What is ABTalks? 🤔</h3>
            <p class="text-light text-start" style="font-size: 0.95rem; line-height: 1.6; padding: 0 10px;">
                ABTalks is an intensive, <strong>strict 60-day coding challenge</strong> meticulously designed for engineering students who want to break out of tutorial hell. Our mission is to help you build unbreakable consistency, develop real-world proof of work, and get noticed by top-tier tech recruiters. 
                <br><br>
                Whether you are aiming for product-based companies or building your own digital venture, this platform forces you to learn, build, and share publicly every single day. Here is exactly how the blueprint works:
            </p>
        </div>

        <div class="action-buttons-container">
            <button class="btn-primary-custom" onclick="openLoginModal()">Accept Challenge 🚀</button>
            <button class="btn-secondary-custom" onclick="scrollToSteps()">See Blueprint 👇</button>
        </div>
    </header>

    <!-- STEPS SECTION -->
    <section class="mb-4" id="steps-section" style="margin-top: 40px; scroll-margin-top: 100px;">
        <div class="feature-card">
            <h3 class="fw-bold mb-4 fs-5 text-center">Your Daily Blueprint 📋</h3>
            
            <h6 class="fw-bold text-info">🎯 Step 1: Pick a Track</h6>
            <p class="text-secondary small mb-4">Choose a specific domain, such as Full-Stack Web Development, Data Structures and Algorithms, or Artificial Intelligence. You must build a project or solve a problem within this chosen track every single day.</p>

            <h6 class="fw-bold text-success">💻 Step 2: The Daily Proof</h6>
            <p class="text-secondary small mb-4">Writing the code is only half the battle. Every day, you are required to submit two specific items on this platform:<br>
            <strong class="text-light">1. A GitHub Repository link</strong> (Proof of your daily coding progress).<br>
            <strong class="text-light">2. A LinkedIn Post link</strong> (Proof that you are documenting and sharing your learnings publicly).</p>

            <h6 class="fw-bold text-primary">🔥 Step 3: Maintain the Streak</h6>
            <p class="text-secondary small mb-0">Your personal dashboard will track your daily progress. If you miss a single submission, your entire streak will reset to zero. Complete the entire 60 days to build a robust portfolio that stands out to technical recruiters.</p>
        </div>
    </section>

</div>

<!-- PROFESSIONAL FOOTER -->
<footer class="text-center pb-5 pt-4 mt-4" style="border-top: 1px solid #334155;">
    <div class="footer-links mb-3">
        <a href="#">About Us</a>
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
    </div>
    <p class="small m-0" style="color: #64748b;">&copy; 2026 ABTalks System. All rights reserved.</p>
</footer>

<!-- ==========================================
     MODALS
=========================================== -->

<!-- 1. LOGIN MODAL -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered px-3">
    <div class="modal-content" style="background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 16px;">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold">Sign In</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center pt-2 pb-4">
        <p class="text-secondary small mb-4">As per hackathon rules, real authentication is disabled. Proceed with the demo account to view the mocked experience.</p>
        
        <button class="btn-glow" data-bs-dismiss="modal" onclick="simulateLogin()">
            Login as Demo Student 🚀
        </button>
        
        <p class="text-warning small mt-3 mb-0" style="font-size: 0.75rem;">
            <em>*Note: Click this mock login to authenticate the session, reveal the navigation menu, and proceed to the application.*</em>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- 2. PROFILE DETAILS MODAL -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered px-3">
      <div class="modal-content" style="background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 16px;">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-title fw-bold">Demo Profile</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start pt-2 pb-4">
          <h4 id="modalName" class="text-light fw-bold mb-0">Name</h4>
          <p id="modalUsername" class="text-secondary small mb-3">@username</p>
          
          <p class="text-success small mb-3"><i class="fa-solid fa-circle text-success me-1" style="font-size: 0.5rem;"></i> Online (Mocked Session)</p>
          
          <div class="p-3 rounded mb-3" style="background-color: #0f172a; border: 1px solid #334155;">
              <p class="mb-1 small"><strong class="text-info">Track:</strong> <span id="modalTrack">Track Name</span></p>
              <p class="mb-0 small"><strong class="text-info">Location:</strong> <span id="modalLocation">Location Details</span></p>
          </div>

          <button class="btn btn-outline-danger w-100 rounded-3" data-bs-dismiss="modal" onclick="simulateLogout()">Logout</button>
        </div>
      </div>
    </div>
  </div>

<!-- 🔥 JAVASCRIPT FOR UI HACK & NEW BUTTONS 🔥 -->
<script>
    let isLoggedIn = false;

    const mockUsers = [
        { name: "Vivek Bisht", username: "@vivek_dev", track: "Full-Stack Web Development", location: "Chandigarh, India" },
        { name: "Vishav", username: "@vishav_code", track: "Data Structures & Algorithms", location: "Chandigarh, India" },
        { name: "Yogesh", username: "@yogesh_builds", track: "Backend Engineering", location: "Chandigarh, India" },
        { name: "Nitesh", username: "@nitesh_ui", track: "Frontend Architecture", location: "Chandigarh, India" },
        { name: "Sameer", username: "@sameer_logic", track: "AI & Machine Learning", location: "Chandigarh, India" }
    ];

    function handleProfileClick() {
        if (!isLoggedIn) {
            var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
            loginModal.show();
        } else {
            document.getElementById('navDropdown').classList.remove('show');
            var profileModal = new bootstrap.Modal(document.getElementById('profileModal'));
            profileModal.show();
        }
    }

    function openLoginModal() {
        if (!isLoggedIn) {
            var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
            loginModal.show();
        } else {
            var profileModal = new bootstrap.Modal(document.getElementById('profileModal'));
            profileModal.show();
        }
    }

    function scrollToSteps() {
        const stepsDiv = document.getElementById('steps-section');
        if (stepsDiv) {
            stepsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function simulateLogin() {
        isLoggedIn = true;
        
        const randomUser = mockUsers[Math.floor(Math.random() * mockUsers.length)];
        
        document.getElementById('modalName').innerText = randomUser.name;
        document.getElementById('modalUsername').innerText = randomUser.username;
        document.getElementById('modalTrack').innerText = randomUser.track;
        document.getElementById('modalLocation').innerText = randomUser.location;
        
        document.getElementById('navWrapper').classList.add('is-logged-in');
        document.getElementById('activeDot').style.display = 'block';
    }

    function simulateLogout() {
        isLoggedIn = false;
        
        document.getElementById('navWrapper').classList.remove('is-logged-in');
        document.getElementById('activeDot').style.display = 'none';
        document.getElementById('navDropdown').classList.remove('show');
    }

    function toggleMenu() {
        document.getElementById('navDropdown').classList.toggle('show');
    }
</script>